{
  "name": "@ai-testing-env/web",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": { "ai-test-dashboard": "./dist/dev.js" },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20" },
  "publishConfig": {
    "access": "public",
    "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "dev": "tsx src/dev.ts",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-testing-env/core": "workspace:*",
    "ai-testing-env": "workspace:*"
  }
}
